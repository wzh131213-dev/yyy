NODE_ENV=production
PORT=8080
# Generate a random secret of at least 24 characters; do not commit real secrets.
ACCESS_TOKEN=replace-with-a-long-random-secret
PUBLIC_BASE_URL=https://your-service.onrender.com
WORKSPACES=/app/workspaces
PAINTED_ANIMATION_TEMPLATE=/opt/painted-animation/template
CHROME_PATH=/usr/bin/chromium
RENDER_SOFT_GL=1
